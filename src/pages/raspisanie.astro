---
import Base from '../layouts/Base.astro';
import { groups, holidays } from '../data/classes.js';
---
<Base title="Расписание" description="Расписание занятий на русском языке для детей и подростков в Эдинбурге.">
  <div class="page-head">
    <div class="wrap">
      <h1>Расписание</h1>
      <p class="lead">Дни и время занятий по группам.</p>
    </div>
  </div>

  <section id="timetable">
    <div class="wrap">
      <h2>Занятия</h2>
      <div>
        {groups.map((group) => (
          <table class="timetable">
            <caption>{group.age}</caption>
            <thead>
              <tr><th scope="col">Занятие</th><th scope="col">Кто ведёт</th><th scope="col">День и время</th></tr>
            </thead>
            <tbody>
              {group.classes.filter((item) => item.when).map((item) => (
                item.when.map((slot, index) => (
                  <tr>
                    {index === 0 && <td rowspan={item.when.length}>{item.name}</td>}
                    <td>{slot.teacher}</td>
                    <td>{slot.time}</td>
                  </tr>
                ))
              ))}
            </tbody>
          </table>
        ))}
      </div>
    </div>
  </section>

  <section id="place">
    <div class="wrap">
      <h2>Место</h2>
      <div>
        <p class="note">25 Palmerston Pl, Edinburgh EH12 5AP<br />BIBLIOTEKA - Classes and Books in Russian</p>
      </div>
    </div>
  </section>

  <section id="holidays">
    <div class="wrap">
      <h2>Каникулы</h2>
      <div>
        <p>Школа не работает по обычному расписанию во время каникул:</p>
        <ul class="class-list">
          {holidays.map((holiday) => (
            <li><strong>{holiday.name}</strong> {holiday.dates}</li>
          ))}
        </ul>
        <p class="note">На время каникул действует особое расписание занятий и мероприятий.</p>
      </div>
    </div>
  </section>
</Base>
