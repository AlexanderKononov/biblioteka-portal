---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
---
<Base title="Взрослым" description="Занятия для взрослых в Эдинбурге.">
  <div class="page-head">
    <div class="wrap">
      <h1>Взрослым</h1>
      <p class="lead">Раздел готовится. Если у вас есть вопросы, <a href="/o-nas/#contacts">напишите нам</a>.</p>
    </div>
  </div>

  <section id="offers">
    <div class="wrap">
      <h2>Занятия</h2>
      <!-- TODO: add each adult class: name, days, short description and price. -->
      <div>
        <Placeholder>Занятия для взрослых, дни и стоимость скоро появятся здесь.</Placeholder>
      </div>
    </div>
  </section>
</Base>
