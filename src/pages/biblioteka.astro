---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
---
<Base title="Книги и правила выдачи" description="Библиотека в Эдинбурге: о библиотеке, правила выдачи и каталог книг.">
  <div class="page-head">
    <div class="wrap">
      <h1>Библиотека</h1>
      <p class="lead">Раздел готовится. Если у вас есть вопросы о библиотеке, <a href="/o-nas/#contacts">напишите нам</a>.</p>
    </div>
  </div>

  <section id="about-library">
    <div class="wrap">
      <h2>О библиотеке</h2>
      <!-- TODO: describe the library: who can use it and how many books it has. -->
      <div>
        <Placeholder>Рассказ о библиотеке скоро появится здесь.</Placeholder>
      </div>
    </div>
  </section>

  <section id="rules">
    <div class="wrap">
      <h2>Правила выдачи</h2>
      <!-- TODO: add the loan period and any deposit. -->
      <div>
        <Placeholder>Срок выдачи и условия скоро появятся здесь.</Placeholder>
      </div>
    </div>
  </section>

  <section id="hours">
    <div class="wrap">
      <h2>Где и когда</h2>
      <!-- TODO: add where and when books are given out. -->
      <div>
        <Placeholder>Адрес и часы работы скоро появятся здесь.</Placeholder>
      </div>
    </div>
  </section>

  <section id="catalogue">
    <div class="wrap">
      <h2>Каталог</h2>
      <!-- TODO: add the book list, grouped by age and topic. -->
      <div>
        <Placeholder>Каталог книг по возрасту и темам скоро появится здесь.</Placeholder>
      </div>
    </div>
  </section>
</Base>
