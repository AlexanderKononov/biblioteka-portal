---
import Base from '../layouts/Base.astro';
import ContactList from '../components/ContactList.astro';
import { groups, holidayNote } from '../data/classes.js';

const classTypes = new Set(groups.flatMap((group) => group.classes.map((item) => item.name))).size;

const stats = [
  { value: groups.length, label: 'возрастные группы' },
  { value: classTypes, label: 'видов занятий' },
  { value: '1–16', label: 'лет — возраст детей и подростков' },
];

const sections = [
  {
    href: '/zanyatiya/',
    title: 'Занятия',
    text: 'Небольшие группы для детей и подростков:',
    list: groups.map((group) => group.age),
    icon: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5M8 7h8M8 11h6',
  },
  {
    href: '/raspisanie/',
    title: 'Расписание',
    text: 'Дни, время и место занятий по группам.',
    icon: 'M4 5h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM3 10h18M8 3v4M16 3v4M7 14h2M11 14h2M15 14h2M7 17h2M11 17h2',
  },
  {
    href: '/biblioteka/',
    title: 'Библиотека',
    text: 'Книги, правила выдачи и каталог.',
    icon: 'M12 6.5C10.5 5 8 4 3 4v15c5 0 7.5 1 9 2.5 1.5-1.5 4-2.5 9-2.5V4c-5 0-7.5 1-9 2.5zM12 6.5v15',
  },
  {
    href: '/vzroslym/',
    title: 'Взрослым',
    text: 'Занятия для взрослых.',
    icon: 'M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM2 21v-1a6 6 0 0 1 6-6h2a6 6 0 0 1 6 6v1M16 3.5a4 4 0 0 1 0 7M18 14.5a6 6 0 0 1 4 5.5v1',
  },
  {
    href: '/meropriyatiya/',
    title: 'Мероприятия',
    text: 'Ближайшие и прошедшие события.',
    icon: 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3z',
  },
  {
    href: '/o-nas/',
    title: 'О нас',
    text: 'Наш подход, педагоги и контакты.',
    icon: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 11v5M12 8h.01',
  },
];
---
<Base description="Поддержка и развитие русского языка через хобби, интересные занятия и общение. Группы для детей от 1 до 16 лет в Эдинбурге.">
  <!-- TODO: add our own hero photo here, with parents' consent. Photos from Instagram or Tilda can't be used. -->
  <div class="hero">
    <div class="wrap">
      <h1>Занятия для детей на русском языке <em>в&nbsp;Эдинбурге</em></h1>
      <p class="lead">Поддержка и развитие русского языка через хобби, интересные занятия и общение.</p>
    </div>
  </div>
  <div class="wrap actions">
    <a class="button" href="/raspisanie/">Расписание</a>
    <a class="button" href="/biblioteka/">Библиотека</a>
  </div>

  <section id="who">
    <div class="wrap">
      <h2>Кто мы</h2>
      <div class="wide">
        <div class="intro-grid">
          <div>
            <p>Мы — мамы и педагоги, живущие в Шотландии, и хорошо знаем, как сложно сохранить русский язык в англоязычной среде.</p>
            <p>Мы создали пространство, где дети и подростки встречаются и общаются на русском не через учебники и зубрёжку правил, а через интересные занятия: творчество, игры и обсуждения.</p>
          </div>
          <div>
            <!-- TODO: confirm the current subjects, including theatre and maths. -->
            <ul class="subject-list">
              <li>Русский</li>
              <li>Арт</li>
              <li>Книги</li>
              <li>Театр</li>
              <li>Математика</li>
            </ul>
            <a class="button" href="/o-nas/">Подробнее о нас</a>
          </div>
        </div>
        <ul class="stats">
          {stats.map((stat) => <li><strong>{stat.value}</strong> <span>{stat.label}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section id="sections" class="band">
    <div class="wrap">
      <h2>Основные направления</h2>
      <div class="wide">
        <ul class="cards">
          {sections.map((section) => (
            <li>
              <a class="card" href={section.href}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={section.icon} /></svg>
                <h3>{section.title}</h3>
                <p>{section.text}</p>
                {section.list && <ul>{section.list.map((item) => <li>{item}</li>)}</ul>}
                <span class="go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="events">
    <div class="wrap">
      <h2>Ближайшие мероприятия</h2>
      <div>
        <article class="event">
          <div>
            <h3>Лекция-дискуссия «Культы и психология манипуляции»</h3>
            <p><strong>Воскресенье, 8 ноября 2026, 15:00–17:00</strong><br />25 Palmerston Place, Edinburgh EH12 5AP<br />Вход бесплатный</p>
            <p>Лекцию читает Екатерина Стрельникова, клинический психолог. <a href="/meropriyatiya/#upcoming">Подробнее о лекции</a></p>
          </div>
        </article>
        <p class="center"><a class="button" href="/meropriyatiya/">Все мероприятия</a></p>
      </div>
    </div>
  </section>

  <section id="faq" class="band band-sun">
    <div class="wrap">
      <h2>Часто задаваемые вопросы</h2>
      <!-- TODO: review these answers. They are written from the Tilda site's facts. -->
      <div class="faq">
        <details>
          <summary>Для какого возраста занятия?</summary>
          <p>Для детей и подростков от 1 до 16 лет. Группы: 1–3 года, 4–7 лет, 8–11 лет и 12–16 лет.</p>
        </details>
        <details>
          <summary>Как проходят занятия?</summary>
          <p>На русском языке, в небольших группах. Вместо учебников и зубрёжки правил — творчество, игры и обсуждения.</p>
        </details>
        <details>
          <summary>Есть ли занятия в школьные каникулы?</summary>
          <p>{holidayNote}</p>
        </details>
        <details>
          <summary>Сколько стоят занятия?</summary>
          <p>Занятия оплачиваются блоками по 4 занятия. Стоимость указана на странице <a href="/zanyatiya/">«Занятия»</a>.</p>
        </details>
        <details>
          <summary>Где проходят занятия?</summary>
          <p>В Эдинбурге. Точное место занятий уточняйте у нас.</p>
        </details>
        <details>
          <summary>Как записаться?</summary>
          <p>Напишите нам в WhatsApp, Telegram или на почту, и мы расскажем о свободных местах.</p>
        </details>
      </div>
    </div>
  </section>

  <section id="contacts">
    <div class="wrap">
      <h2>Контакты</h2>
      <div>
        <p>Напишите нам, чтобы узнать о свободных местах и записаться на занятия.</p>
        <ContactList />
        <p class="place">Эдинбург, Великобритания</p>
      </div>
    </div>
  </section>
</Base>
