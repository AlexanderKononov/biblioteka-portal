---
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
---
<Base title="Мероприятия" description="Мероприятия и мастер-классы на русском языке в Эдинбурге.">
  <div class="page-head">
    <div class="wrap">
      <h1>Мероприятия</h1>
      <p class="lead">Раздел готовится. Чтобы узнать о ближайших событиях, <a href="/o-nas/#contacts">напишите нам</a>.</p>
    </div>
  </div>

  <section id="upcoming">
    <div class="wrap">
      <h2>Ближайшие</h2>
      <!-- TODO: add upcoming events: date, time, place, age, price and how to sign up. -->
      <div>
        <Placeholder>Ближайшие мероприятия скоро появятся здесь.</Placeholder>
      </div>
    </div>
  </section>

  <section id="past">
    <div class="wrap">
      <h2>Прошедшие</h2>
      <!-- TODO: add past events, or remove this section. -->
      <div>
        <Placeholder>Рассказы о прошедших мероприятиях скоро появятся здесь.</Placeholder>
      </div>
    </div>
  </section>
</Base>
