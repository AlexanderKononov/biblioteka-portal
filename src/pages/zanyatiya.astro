---
import Base from '../layouts/Base.astro';
import { groups, onlineGroup, holidayNote } from '../data/classes.js';
---
<Base title="Занятия" description="Занятия на русском языке для детей и подростков от 1 до 16 лет в Эдинбурге: группы, длительность и стоимость.">
  <div class="page-head">
    <div class="wrap">
      <h1>Занятия</h1>
      <p class="lead">Небольшие группы для детей-билингвов и детей-экспатов от 1,6 до 16 лет.</p>
      <div class="students">
        <p>Наши ученики:</p>
        <ul>
          <li>дети из двуязычных семей, где один из родителей является русскоговорящим;</li>
          <li>дети экспатов, для которых русский язык является родным или одним из родных языков и которые длительное время находились в русскоязычной среде.</li>
        </ul>
      </div>
    </div>
  </div>

  <section id="groups">
    <div class="wrap">
      <h2>Группы</h2>
      <div>
        {[...groups, onlineGroup].map((group) => (
          <article class="group" id={group.id}>
            <h3>{group.age}</h3>
            <div>
              {group.note && <p>{group.note}</p>}
              <ul class="class-list">
                {group.classes.map((item) => (
                  <li>
                    <div class="class-row"><strong>{item.name}</strong> {(item.duration || item.ages) && <span>{item.duration || item.ages}</span>}</div>
                    {item.text && <p>{item.text}</p>}
                    {item.topics && (
                      <ul class="topics">
                        {item.topics.map((topic) => <li>{topic}</li>)}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
              <div class="group-foot">
                <p>{group.price}</p>
                <a class="button" href="/o-nas/#contacts">Записаться</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="good-to-know">
    <div class="wrap">
      <h2>Важно знать</h2>
      <div>
        <p class="note">{holidayNote} Даты каникул смотрите на странице <a href="/raspisanie/#holidays">«Расписание»</a>.</p>
        <p class="note">Дни и время занятий смотрите в <a href="/raspisanie/">расписании</a>.</p>
      </div>
    </div>
  </section>
</Base>
