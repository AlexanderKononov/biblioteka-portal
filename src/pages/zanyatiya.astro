---
import Base from '../layouts/Base.astro';
import { groups, holidayNote } from '../data/classes.js';
---
<Base title="Занятия" description="Занятия на русском языке для детей и подростков от 1 до 16 лет в Эдинбурге: группы, длительность и стоимость.">
  <div class="page-head">
    <div class="wrap">
      <h1>Занятия</h1>
      <p class="lead">Небольшие группы для билингвальных детей и подростков от 1 до 16 лет.</p>
    </div>
  </div>

  <section id="groups">
    <div class="wrap">
      <h2>Группы</h2>
      <!-- TODO: confirm the current classes and prices. The 1–3 group's name and £20 price come from Tilda and differ from the other groups. -->
      <div>
        {groups.map((group) => (
          <article class="group" id={group.id}>
            <h3>{group.age}</h3>
            <div>
              <p class="intro">{group.intro}</p>
              <ul class="class-list">
                {group.classes.map((item) => (
                  <li>
                    <div class="class-row"><strong>{item.name}</strong> <span>{item.duration}</span></div>
                    <p>{item.text}</p>
                  </li>
                ))}
              </ul>
              <div class="group-foot">
                <p>{group.price}</p>
                <a class="button" href="/o-nas/#contacts">Записаться</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="good-to-know">
    <div class="wrap">
      <h2>Важно знать</h2>
      <div>
        <p class="note">{holidayNote}</p>
        <p class="note">Дни и время занятий смотрите в <a href="/raspisanie/">расписании</a>.</p>
      </div>
    </div>
  </section>
</Base>
